# Restaurant website template environment configuration

# Public site URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin dashboard credentials
ADMIN_USERNAME=admin
ADMIN_SECRET_KEY=replace_with_a_long_unique_password
ADMIN_SESSION_SECRET=replace_with_a_random_64_character_secret

# Optional Supabase configuration
# If not configured, the app seamlessly runs using the built-in resilient local file database.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
