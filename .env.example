# ========================================================================
# DURRANI WEB DEVELOPERS - ENVIRONMENT CONFIGURATION
# Production-ready configuration for Vercel & Supabase
# ========================================================================

# 1. ADMIN CREDENTIALS & SESSION SECURITY
ADMIN_USERNAME=durraniwebdevelopers
ADMIN_PASSWORD=
SESSION_SECRET=

# 2. VERCEL CRON AUTOMATION SECRET
# Required to protect /api/cron/reminders from unauthorized calls
CRON_SECRET=

# 3. SUPABASE (Required for private customer receipt uploads and payment instructions)
# Create a dedicated DWD project and run supabase/payment-workflow.sql.
# The service-role key is server-only. Never rename it with a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 4. ADMIN NOTIFICATIONS (Optional; enable the channels you have configured)
# Resend requires a verified sender address. Alerts go to ADMIN_NOTIFICATION_EMAIL
# or default to the DWD business email.
RESEND_API_KEY=
# Example: Durrani Web Developers <notifications@your-verified-domain.com>
RESEND_FROM_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# WhatsApp Cloud API requires a Meta-approved message template with four body
# placeholders, in this order: alert type, reference, customer name/phone, details.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ADMIN_PHONE=923296260778
WHATSAPP_ADMIN_TEMPLATE_NAME=
WHATSAPP_ADMIN_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v23.0

# 5. SAFEPAY HOSTED CARD CHECKOUT (Sandbox first; keep secret keys server-side)
# Get separate sandbox credentials from the Safepay sandbox dashboard.
# NEXT_PUBLIC_SITE_URL must be a publicly reachable HTTPS origin for redirects/webhooks.
SAFEPAY_PUBLIC_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENVIRONMENT=sandbox
NEXT_PUBLIC_SITE_URL=
