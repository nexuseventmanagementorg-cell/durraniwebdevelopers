# ========================================================================
# DURRANI WEB DEVELOPERS - ENVIRONMENT CONFIGURATION
# Production-ready configuration for Vercel & Supabase
# ========================================================================

# 1. ADMIN CREDENTIALS & SESSION SECURITY
ADMIN_EMAIL=admin@durraniwebdevelopers.com
ADMIN_PASSWORD=Durrani2026!Secure
SESSION_SECRET=your_super_secret_session_encryption_key_change_in_production

# 2. VERCEL CRON AUTOMATION SECRET
# Required to protect /api/cron/reminders from unauthorized calls
CRON_SECRET=your_vercel_cron_secret_key_here

# 3. SUPABASE POSTGRESQL (Optional - Persistent local JSON store is active by default)
# When deploying to Supabase, configure your project URL and service role key:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-do-not-expose-to-browser

# 4. EXTERNAL NOTIFICATION PROVIDERS (Optional)
# If provided, reminders will be dispatched automatically via API;
# otherwise, reminders are safely marked as "Pending Manual Action" with WhatsApp click-to-send buttons.
RESEND_API_KEY=
WHATSAPP_API_TOKEN=
